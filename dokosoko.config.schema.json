{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dokosoko.dev/schemas/dokosoko.config.v1.schema.json",
  "title": "DokoSoko central configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "version": { "const": 1 },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "listen": { "type": "string", "minLength": 1 },
        "public_url": { "type": "string", "minLength": 1 },
        "ui_directory": { "type": "string", "minLength": 1 }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "$ref": "#/$defs/secretReference" },
        "migrations_directory": { "type": "string", "minLength": 1 }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "master_key": { "$ref": "#/$defs/secretReference" },
        "setup_token": { "$ref": "#/$defs/secretReference" },
        "dev_memory": { "type": "boolean" },
        "allow_demo_tokens": { "type": "boolean" },
        "allow_insecure_http": { "type": "boolean" }
      }
    },
    "uploads": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directory": { "type": "string", "minLength": 1 },
        "max_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "localhost_hosts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "native_plugins": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "disabled": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "api_key": { "$ref": "#/$defs/secretReference" },
        "endpoint": { "type": "string" },
        "analysis": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": { "type": "string", "minLength": 1 },
            "max_input_tokens": { "type": "integer", "minimum": 256, "maximum": 1000000 },
            "max_output_tokens": { "type": "integer", "minimum": 1, "maximum": 32768 },
            "daily_token_budget": { "type": "integer", "minimum": 0, "maximum": 10000000000 }
          }
        }
      }
    },
    "crawler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_pages": { "type": "integer", "minimum": 1 },
        "max_bytes": { "type": "integer", "minimum": 1 },
        "data_directory": { "type": "string", "minLength": 1 },
        "upload_directory": { "type": "string", "minLength": 1 },
        "allow_localhost_subdomains": { "type": "boolean" },
        "localhost_ports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
        }
      }
    },
    "control_plane": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organisation": { "$ref": "#/$defs/identity" },
        "deployment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 120 },
            "slug": { "$ref": "#/$defs/slug" },
            "description": { "type": "string", "maxLength": 2000 },
            "feedback_submission_url": { "type": "string", "maxLength": 2048 },
            "error_submission_url": { "type": "string", "maxLength": 2048 }
          }
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "slug"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 120 },
              "slug": { "$ref": "#/$defs/slug" },
              "is_production": { "type": "boolean" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "slug": { "$ref": "#/$defs/slug" }
      }
    },
    "secretReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "env": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        { "required": ["env"] },
        { "required": ["file"] }
      ]
    }
  }
}
