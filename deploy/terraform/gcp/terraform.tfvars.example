project_id = "my-gcp-project"
region     = "us-central1"
zone       = "us-central1-a"

# This must route to the Cloud Run service. Use a planned custom domain, or apply
# once with the known default Cloud Run URL and keep the value stable afterward.
public_url = "https://dokosoko.example.com"

service_image = "us-central1-docker.pkg.dev/my-gcp-project/apps/dokosoko@sha256:replace-me"
crawler_image = "us-central1-docker.pkg.dev/my-gcp-project/apps/dokosoko-crawler@sha256:replace-me"

database_password = "replace-with-at-least-24-characters"
master_key         = "replace-with-32-random-bytes-encoded-as-base64"
setup_token        = "replace-with-at-least-32-random-characters"

# ai_provider       = "openai"
# ai_api_key        = "replace-me"
# ai_endpoint       = "https://api.openai.com/v1"
# ai_model_analysis = "gpt-5.6-terra"
