# Replace all required values before starting Compose.
DOKOSOKO_DATABASE_PASSWORD=replace-with-a-long-random-database-password
# May be left empty only when the mounted central file references a master-key secret file.
DOKOSOKO_MASTER_KEY=replace-with-standard-base64-for-exactly-32-random-bytes
DOKOSOKO_SETUP_TOKEN=replace-with-a-long-random-one-time-setup-token
DOKOSOKO_PUBLIC_URL=http://localhost:8080

# Optional versioned central configuration shared by the service and crawler.
# This path must exist inside each container when Compose is used; mount the
# file with a small compose override. Environment variables override its values.
# DOKOSOKO_CONFIG_FILE=/etc/dokosoko/dokosoko.config.json

# Stable tenant fields can be managed centrally. These override matching values
# in the JSON file. Initial environment creation is expressed in the JSON file.
# DOKOSOKO_ORGANISATION_NAME=Example Organisation
# DOKOSOKO_ORGANISATION_SLUG=example-organisation
# DOKOSOKO_DEPLOYMENT_NAME=Example Developer Platform
# DOKOSOKO_DEPLOYMENT_SLUG=example-developer-platform
# DOKOSOKO_DEPLOYMENT_DESCRIPTION=Trusted API knowledge and tools.
# DOKOSOKO_DEPLOYMENT_FEEDBACK_SUBMISSION_URL=https://support.example.com/feedback
# DOKOSOKO_DEPLOYMENT_ERROR_SUBMISSION_URL=https://support.example.com/errors

# Secrets can also be loaded from mounted files. Do not set both the direct and
# _FILE form of one secret.
# DOKOSOKO_DATABASE_URL_FILE=/run/secrets/dokosoko_database_url
# DOKOSOKO_MASTER_KEY_FILE=/run/secrets/dokosoko_master_key
# DOKOSOKO_SETUP_TOKEN_FILE=/run/secrets/dokosoko_setup_token

# Optional environment-managed AI connection. The console can configure the
# same providers instead. Supported first-class values are openai, google,
# anthropic, digitalocean, xai, and deepseek. Keep the API key secret.
# DOKOSOKO_AI_PROVIDER=openai
# DOKOSOKO_AI_API_KEY=replace-with-provider-api-key
# DOKOSOKO_AI_API_KEY_FILE=/run/secrets/dokosoko_ai_api_key
# DOKOSOKO_AI_ENDPOINT=
# DOKOSOKO_AI_MODEL_ANALYSIS=gpt-5.6-terra
# DOKOSOKO_AI_MAX_INPUT_TOKENS=128000
# DOKOSOKO_AI_MAX_OUTPUT_TOKENS=4096
# DOKOSOKO_AI_DAILY_TOKEN_BUDGET=0

# Reviewed-upload and crawler safety budgets. Compose stores uploads in the
# private dokosoko-uploads volume; the service writes and the crawler reads.
DOKOSOKO_UPLOAD_MAX_BYTES=5000000
DOKOSOKO_CRAWLER_MAX_PAGES=500
DOKOSOKO_CRAWLER_MAX_BYTES=5000000

# Development-only localhost-subdomain access. Keep the crawler switch false in
# production. The tool runtime accepts local resolution only for the exact,
# comma-separated hostname:port destinations below, including loopback.
# The crawler additionally restricts local destinations to the listed ports.
DOKOSOKO_CRAWLER_ALLOW_LOCALHOST_SUBDOMAINS=false
DOKOSOKO_CRAWLER_LOCALHOST_HOST=api.your-service.localhost
DOKOSOKO_CRAWLER_LOCALHOST_PORTS=80,443
DOKOSOKO_TOOL_LOCALHOST_HOSTS=api.your-service.localhost:8080
